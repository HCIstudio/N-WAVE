   "subworkflow": null,
   "code": "process REPORT {\n    input:\n    path files\n\n    output:\n    path 'report.html'\n\n    script:\n    \"touch report.html\"\n}",
   "conditions": []
  },
  {
   "id": "TRIM",
   "name": "TRIM",
   "process": "TRIM",
   "file": "main.nf",
   "subworkflow": null,
   "code": "process TRIM {\n    input:\n    path reads\n\n    output:\n    path 'trimmed.fastq', emit: reads\n\n    script:\n    \"cp ${reads} trimmed.fastq\"\n}",
   "conditions": [
    "params.trim"
   ]
  }
